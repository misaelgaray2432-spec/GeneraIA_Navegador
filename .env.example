# Ollama local: qwen3.5:2b es el modelo disponible en este equipo; think=false y una temperatura baja favorecen respuestas directas.
# Alwaysdata: configura una URL de Ollama accesible desde el servidor; 127.0.0.1 apunta al propio alojamiento.
# OLLAMA_API_KEY es opcional y se envía como token Bearer.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen3.5:2b
OLLAMA_VISION_MODEL=qwen3.5:2b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512

# Unsplash API: Access Key de una aplicación registrada en Unsplash Developers.
UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY

DB_HOST=mysql-[account].alwaysdata.net
DB_NAME=your_account_database
DB_USER=your_account_user
DB_PASS=CHANGE_ME